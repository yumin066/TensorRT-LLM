+# FFmpeg/decoder error base, resolved defensively across PyAV versions.
+_AV_ERR = getattr(av, "FFmpegError", None) or getattr(getattr(av, "error", None), "FFmpegError", Exception)
+
+
+def preflight_external_retake(ext_path: str, meta_in, fps_rtol: float = 0.02) -> None:
+    """Validate a caller-supplied retake clip against the retake-input geometry
+    before it is spliced back in. The composite indexes frames [0, total) and
+    overwrites whole frame arrays, so an external clip must match the retake
+    input's frame count and pixel dimensions EXACTLY; mismatches are rejected
+    loudly (no silent scale/pad/resample). Also confirms the clip decodes."""
+    ext = get_videostream_metadata(ext_path)
+    problems = []
+    if ext.frames != meta_in.frames:
+        problems.append(f"frame_count {ext.frames} != retake_input {meta_in.frames}")
+    if ext.width != meta_in.width or ext.height != meta_in.height:
+        problems.append(f"resolution {ext.width}x{ext.height} != retake_input {meta_in.width}x{meta_in.height}")
+    if meta_in.fps > 0 and abs(ext.fps - meta_in.fps) > fps_rtol * meta_in.fps:
+        problems.append(f"fps {ext.fps:.4f} != retake_input {meta_in.fps:.4f}")
+    try:
+        with av.open(ext_path) as container:
+            vstream = next(s for s in container.streams if s.type == "video")
+            next(container.decode(vstream)).to_ndarray(format="rgb24")
+    except (StopIteration, ValueError, OSError, _AV_ERR) as e:
+        problems.append(f"pix_fmt/decode: {e}")
+    if problems:
+        raise SystemExit("[external-retake] rejected: " + "; ".join(problems))
+
